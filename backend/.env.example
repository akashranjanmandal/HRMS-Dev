# Copy to .env and fill in for your environment. Every value here has a
# working default in app/core/config.py — this file documents what's
# configurable, it is not required to run the app locally.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aaranyak_hrms
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Email. Leave SMTP_HOST empty to run in dev/test mode: emails are kept
# in app.services.mailer.OUTBOX instead of being sent, and nothing here
# needs a value.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Aaranyak HRMS <noreply@aaranyak.org>

# Dev/demo convenience only — makes every email OTP this fixed value so
# manual testing doesn't need to read the mail outbox. Leave empty
# (the default) everywhere except a throwaway local dev box; the app
# refuses to start if this is set at the same time as a real SMTP_HOST.
DEV_FIXED_OTP=
